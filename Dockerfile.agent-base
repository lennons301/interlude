# The agent image BASE (issue #216): everything an agent container needs that
# is not the harness itself — git, gh, yq, jq, pnpm, the workspace user and the
# estate's pinned skills. Each harness adapter's image is a thin layer on top
# of this one (`Dockerfile.agent-<adapter id>`, e.g. Dockerfile.agent-claude-code)
# that installs one harness and pre-accepts its headless mode, so a second
# harness neither bloats this image nor forks this file.
#
# The image builder (src/lib/docker/image-builder.ts) builds this file as
# `interlude-agent-base:latest` and stamps it with this file's SHA-256; an
# adapter image is stamped with a hash over this file AND its own layer, so a
# change here rebuilds every adapter's image and a harness bump in one layer
# rebuilds that image alone. Nothing here may INSTALL a harness or pre-accept
# one's headless mode — that belongs in its layer; harnesses are named below
# only as readers of the skills (the installer's agent targets, and the
# `~/.claude` directory the Claude Code links land in).
FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    iproute2 \
    jq \
    && rm -rf /var/lib/apt/lists/*

# yq (mikefarah) — a standalone YAML processor, not packaged for Debian.
# Paired with jq (above) so in-container repo checks and review-gates tooling
# that parse JSON/YAML can validate their own work; the platform repo's
# checks/tests/*.sh need both (issue #71). Pinned by version and verified by
# SHA-256 because it's a raw binary download.
ARG YQ_VERSION=v4.53.3
RUN arch="$(dpkg --print-architecture)" \
    && case "$arch" in \
         amd64) yq_sha256="fa52a4e758c63d38299163fbdd1edfb4c4963247918bf9c1c5d31d84789eded4" ;; \
         arm64) yq_sha256="578648e463a11c1b6db6010cbf41eafed6bee79466fcffa1bb446672cf7945ea" ;; \
         *) echo "unsupported arch for yq: $arch" >&2; exit 1 ;; \
       esac \
    && curl -fsSL "https://github.com/mikefarah/yq/releases/download/${YQ_VERSION}/yq_linux_${arch}" -o /usr/local/bin/yq \
    && echo "${yq_sha256}  /usr/local/bin/yq" | sha256sum -c - \
    && chmod 0755 /usr/local/bin/yq \
    && yq --version

# GitHub CLI (`gh`) — generation-session skills (issue #60) and the ticket-loop
# tooling read and comment on issues through `gh`; the container's short-lived
# GitHub App token is exposed per exec exactly like git's. Installed from
# GitHub's own apt repository (the canonical install), so it tracks upstream
# `stable`; the `arch=` clause keeps it correct on the amd64/arm64 hosts the
# estate runs on.
RUN mkdir -p -m 755 /etc/apt/keyrings \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@latest --activate

# Run as the existing node user (uid 1000), which also matches the deploy
# user on the host — kept aligned so any future host bind mount stays
# uid-consistent (issue #28 removed the last one: the host ~/.claude mount).
RUN mkdir -p /workspace && chown node:node /workspace

# Image-owned Claude directory: where the skills install below links each skill
# for the Claude Code agent. Nothing is mounted over it now (#28), so anything
# installed here survives at runtime. It is the skills' directory, not the
# harness's — the Claude CLI itself, and its headless pre-acceptance, are the
# Claude Code layer's (Dockerfile.agent-claude-code).
RUN mkdir -p /home/node/.claude && chown -R node:node /home/node/.claude

USER node

# The estate's generation and workflow skills — Matt Pocock's `mattpocock/skills`
# — installed at image build through the open Agent Skills standard (issue
# #215). This replaces the `claude plugin install` that ran at every container
# setup (issue #60): that was Claude-only by construction, cost ~9s of
# wall-clock on every start (8.7s measured on the pre-#215 image, warm, live
# network), and, being unpinned, let an upstream release change a pass mid-day. The installer writes the canonical skill folders to
# `~/.agents/skills/<name>/SKILL.md` — the standard location Codex and OpenCode
# read natively — and links `~/.claude/skills/<name>` to them for Claude Code.
# All three agents are targeted so the canonical folders exist at all: given a
# single target the installer copies straight into that agent's directory.
# The `/tree/<tag>` URL is how the ref is pinned (the `add` command has no ref
# flag; the bare `mattpocock/skills` source installs `main`), and the lock file
# then records the ref per skill, which the assertion below checks — reading
# the installer's own lock (`~/.agents/.skill-lock.json`, version 3), so an
# installer release that reshaped the lock would fail this build for a reason
# other than a missing skill. That is the right failure: the pin would then be
# unverified, and the installer is pinned too so it happens on a deliberate
# bump rather than overnight.
#
# SKILLS_REF is the one statement of the pinned ref: this RUN installs it, the
# LABEL stamps it on the image — every adapter image inherits the label from
# this base, and the orchestrator lifts it from there into the run ledger's
# skills-version column and the task feed's system note — and the image
# builder's hash covers it, so bumping it here rebuilds every adapter image.
# Runs as `node`, after USER above, so global scope is /home/node.
ARG SKILLS_REF=v1.2.3
ARG SKILLS_INSTALLER_VERSION=1.5.23
# Every skill a pass or a session can name must resolve in the image (the
# estate's capability-contract rule): a skill installed this way is a plain
# skill, not a namespaced plugin, so `/grill-me` and a `workflow:tdd` label
# resolve by these exact names or not at all. The list is the schema's session
# skills (SESSION_SKILLS, src/db/schema.ts) plus every vendored workflow under
# docs/agents/workflows/ by file stem; image-builder.test.ts pins it to both,
# so a skill added to either without being listed here fails the test, and a
# listed skill missing from the installed set fails the build.
ARG REQUIRED_SKILLS="grill-me grill-with-docs triage to-spec to-tickets wayfinder tdd"
RUN npx -y "skills@${SKILLS_INSTALLER_VERSION}" add "https://github.com/mattpocock/skills/tree/${SKILLS_REF}" -g -y -s '*' -a claude-code -a codex -a opencode \
    && for skill in ${REQUIRED_SKILLS}; do \
         test -f "/home/node/.agents/skills/${skill}/SKILL.md" \
           || { echo "ERROR: skill '${skill}' is missing from the installed set" >&2; exit 1; }; \
         test -f "/home/node/.claude/skills/${skill}/SKILL.md" \
           || { echo "ERROR: skill '${skill}' has no Claude Code link" >&2; exit 1; }; \
         test "$(jq -r --arg s "${skill}" '.skills[$s].ref // empty' /home/node/.agents/.skill-lock.json)" = "${SKILLS_REF}" \
           || { echo "ERROR: skill '${skill}' is not pinned to ${SKILLS_REF}" >&2; exit 1; }; \
       done \
    && rm -rf /home/node/.npm/_npx
LABEL co.interlude.agent-skills-ref=${SKILLS_REF}

# The base ends as `node` in /workspace; an adapter layer inherits both, and
# switches to root only for as long as its harness install needs it.
WORKDIR /workspace
