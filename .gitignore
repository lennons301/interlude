# project
.superpowers/
local.db
local.db-wal
local.db-shm

# Passive stream-observation log (issue #165) — lands beside the database,
# so in local dev that is the repo root.
stream-observations.jsonl
stream-observations.jsonl.1

# Paused passes' session transcripts (issue #169) — beside the database too, so
# a local dev pause leaves a directory here rather than in the diff.
session-transcripts/

# Docker
.docker/
# generated by deploy — proxy env rendered from Doppler (interlude/prd)
caddy.env
