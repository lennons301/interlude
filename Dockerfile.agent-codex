# The Codex CLI layer of the agent image (issues #216, #221): one harness on
# the shared base (Dockerfile.agent-base), which carries everything else —
# git, gh, yq, jq, pnpm, the workspace user and the pinned skills, including the
# `~/.agents/skills` canonical folders this harness reads natively.
#
# The image builder (src/lib/docker/image-builder.ts) builds the base first and
# hands its tag in as BASE_IMAGE; the default below is that same tag, so a
# manual `docker build -f Dockerfile.agent-codex .` after a base build works
# too. The resulting image is stamped with a hash over BOTH files, so a base
# change rebuilds this image and a change here rebuilds only this one.
ARG BASE_IMAGE=interlude-agent-base:latest
FROM ${BASE_IMAGE}

# The base leaves the image running as `node`; the global install needs root.
# The package is a launcher with a per-platform optional dependency
# (@openai/codex-linux-x64 / -linux-arm64), so one install line serves both
# hosts the estate runs on.
USER root
RUN npm install -g @openai/codex

# Where every turn's sessions persist (src/lib/harness/codex/index.ts). Each
# turn runs the CLI in a Codex home created for that one exec and removed when
# it ends — that is how the ChatGPT-plan credential file never outlives a turn
# — and links that home's `sessions` here, so a thread can be resumed by the
# next turn. The cleanup normalises each rollout into the `interlude`
# subdirectory under a deterministic name, which is the path a pause copies out.
#
# Nothing to pre-accept: headless Codex takes its approval and sandbox bypass
# per invocation (`--dangerously-bypass-approvals-and-sandbox`), and the
# container is the sandbox.
RUN mkdir -p /home/node/.codex-sessions/interlude && chown -R node:node /home/node/.codex-sessions

USER node
